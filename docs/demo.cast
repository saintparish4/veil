[13.71891, "o", "\r\nACCESS CONTROL RESOLUTION\r\n\r\n  gates on the caller (43)\r\n"]
[13.720084, "o", "      13  onlyRole\r\n      10  onlyAuthorized\r\n      10  onlyGovernance\r\n       6  onlyOwner\r\n       2  onlyRoleOrOpenRole\r\n       2  restricted\r\n\r\n  does NOT gate on the caller (46)\r\n      17  initializer\r\n      13  onlyInitializing\r\n       5  nonReentrant\r\n       5  whenNotPaused\r\n       2  reinitializer\r\n       2  whenPaused\r\n       1  notDelegated\r\n       1  onlyProxy\r\n\r\n  could not resolve (0)\r\n    none\r\n"]
[21.859076, "o", "\u001b[H\u001b[2J\u001b[3J"]
[22.261927, "o", "\u001b[38;5;245m# 'initializer' prevents RE-initialization. It does not restrict WHO calls the\u001b[0m\r\n"]
[22.614588, "o", "\u001b[38;5;245m# function — the bug class that froze $150M in the Parity multisig.\u001b[0m\r\n"]
