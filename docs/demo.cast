[4.776725, "o", "\r\nPROJECT   openzeppelin-contracts/contracts\r\n\r\n  Files          217 analysed\r\n  Declarations   174 contracts, 48 interfaces, 25 libraries\r\n  Imports        409 resolved, 0 unresolved\r\n\r\n\r\n"]
