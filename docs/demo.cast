[0.021272, "o", "\u001b[H\u001b[2J\u001b[3J"]
[1.027214, "o", "\u001b[38;5;245m# Most Solidity scanners read one file at a time — so when they see\u001b[0m\r\n"]
[1.379585, "o", "\u001b[38;5;245m# 'onlyOwner' they have to guess, from the name, whether it protects anything.\u001b[0m\r\n"]
[1.731826, "o", "\u001b[38;5;245m\u001b[0m\r\n"]
[2.08406, "o", "\u001b[38;5;245m# Veil resolves the whole protocol first: imports, inheritance, C3 linearization.\u001b[0m\r\n"]
